{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "820px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#20201E",
          "name": "Ink"
        },
        {
          "slug": "paper",
          "color": "#F4F0E8",
          "name": "Paper"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "clay",
          "color": "#C65D3A",
          "name": "Clay"
        },
        {
          "slug": "sand",
          "color": "#D8CBB8",
          "name": "Sand"
        },
        {
          "slug": "sage",
          "color": "#7C8875",
          "name": "Sage"
        },
        {
          "slug": "muted",
          "color": "#77746E",
          "name": "Muted"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "Arial, Helvetica, sans-serif",
          "slug": "display",
          "name": "Studio Sans"
        },
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "slug": "editorial",
          "name": "Editorial Serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.125rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "clamp(2.5rem, 5vw, 4.5rem)",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "clamp(3.5rem, 8vw, 7.5rem)",
          "name": "Display"
        }
      ],
      "fluid": true
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "S"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "M"
        },
        {
          "slug": "50",
          "size": "2.5rem",
          "name": "L"
        },
        {
          "slug": "60",
          "size": "4rem",
          "name": "XL"
        },
        {
          "slug": "70",
          "size": "6rem",
          "name": "2XL"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "0px"
        }
      },
      "core/image": {
        "border": {
          "radius": "0px"
        }
      },
      "core/cover": {
        "dimensions": {
          "minHeight": "420px"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "#F4F0E8",
      "text": "#20201E"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--display)",
      "fontSize": "16px",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(24px, 5vw, 80px)",
        "right": "clamp(24px, 5vw, 80px)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "0.98",
          "letterSpacing": "-0.055em"
        },
        "color": {
          "text": "#20201E"
        }
      },
      "link": {
        "color": {
          "text": "#20201E"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "color": {
          "background": "#20201E",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "0px"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "24px",
            "right": "24px"
          }
        },
        "typography": {
          "fontSize": "0.8rem",
          "fontWeight": "700",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "16px",
          "lineHeight": "1.7"
        }
      }
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "blockGap": "1.25rem"
        }
      },
      "core/paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "16px",
          "lineHeight": "1.7"
        }
      },
      "core/post-title": {
        "typography": {
          "lineHeight": "1.05",
          "letterSpacing": "-0.04em"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "700",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        }
      },
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "0.98",
          "letterSpacing": "-0.055em"
        }
      }
    }
  }
}
